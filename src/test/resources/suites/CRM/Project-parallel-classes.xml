<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="CRM Projects Parallel Classes Suite" parallel="classes" configfailurepolicy="continue">

    <listeners>
        <listener class-name="com.practiceCRM.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="Projects Test - Parallel Classes">
        <parameter name="BROWSER" value="chrome"/>
        <classes>
            <class name="com.practiceCRM.projects.crm.testcases.projects.ProjectGridTest"/>
            <class name="com.practiceCRM.projects.crm.testcases.projects.ProjectCRUDTest"/>
            <class name="com.practiceCRM.projects.crm.testcases.projects.ProjectFilterTest"/>
        </classes>
    </test>
</suite>
